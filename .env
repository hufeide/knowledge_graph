### 仅保留 kg_builder/config.py 实际读取的配置；其余均为 LightRAG 模板残留，已删除。
### 修改后重启服务（python run.py）生效。

### 服务端口
HOST=0.0.0.0
KG_WEB_PORT=9622

### LLM（OpenAI 兼容端点）
LLM_BINDING=openai
LLM_BINDING_HOST=http://localhost:9000/v1
LLM_BINDING_API_KEY=sk-1234
LLM_MODEL=qwen

### Embedding（OpenAI 兼容端点）
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://localhost:9001/v1
EMBEDDING_BINDING_API_KEY=none
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

### 分块参数
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=200
CHUNK_WORKERS=2

### 抽取策略：two_pass=先抽实体再抽关系（关系更丰富、对通用/抽象文本更稳）；single=单次（快但易漏关系）
EXTRACTION_MODE=two_pass

### 可选 Neo4j 图存储后端（默认 networkx；启用时另设 KG_GRAPH_BACKEND=neo4j）
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hufei1989
NEO4J_DATABASE=neo4j

### GraphRAG 检索参数
QA_TOP_K=5
QA_GRAPH_HOPS=2
QA_GRAPH_MAX_NODES=40
QA_RERANK_VECTOR=0.5
QA_RERANK_GRAPH=0.3
QA_RERANK_PROV=0.2
